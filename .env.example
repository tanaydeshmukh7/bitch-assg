# Supabase Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable anon key (safe for client-side and standard user-scoped calls)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# Secret service role key (backend operations only, bypasses RLS for administrative jobs if needed)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Frontend-safe aliases. Never put SUPABASE_SECRET_KEY in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Hugging Face AI Configuration
# Create token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
# Model identifier for Qwen 2.5 / 3 32B or compatible endpoint
# e.g. Qwen/Qwen2.5-Coder-32B-Instruct or Qwen/Qwen2.5-32B-Instruct
HF_MODEL=Qwen/Qwen2.5-32B-Instruct
# Optional custom base URL (e.g. Hugging Face Inference Endpoints or router URL)
# Default router: https://api-inference.huggingface.co/models
HF_BASE_URL=https://api-inference.huggingface.co/models

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
